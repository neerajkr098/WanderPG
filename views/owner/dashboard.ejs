<% layout("/layouts/boilerplate") %>

<div class="container my-5">
  <!-- Dashboard Header -->
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
      <h2 class="fw-bold mb-1 text-dark">
        <i class="fa-solid fa-gauge-high text-danger me-2"></i>Owner Dashboard
      </h2>
      <p class="text-muted mb-0">Manage your PG properties, review status, and student availability</p>
    </div>
    <div>
      <a href="/listings/new" class="btn btn-danger rounded-pill px-4 fw-semibold shadow-sm">
        <i class="fa-solid fa-plus me-1"></i> List New PG
      </a>
    </div>
  </div>

  <!-- Quick Stats Cards -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <div class="text-muted small fw-semibold">Total PGs</div>
            <h3 class="fw-bold mb-0 text-dark"><%= stats.total %></h3>
          </div>
          <div class="rounded-circle bg-light p-3 text-secondary">
            <i class="fa-solid fa-building fs-5"></i>
          </div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <div class="text-muted small fw-semibold">Live & Approved</div>
            <h3 class="fw-bold mb-0 text-success"><%= stats.approved %></h3>
          </div>
          <div class="rounded-circle bg-success-subtle p-3 text-success">
            <i class="fa-solid fa-circle-check fs-5"></i>
          </div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <div class="text-muted small fw-semibold">Pending Review</div>
            <h3 class="fw-bold mb-0 text-warning"><%= stats.pending %></h3>
          </div>
          <div class="rounded-circle bg-warning-subtle p-3 text-warning">
            <i class="fa-solid fa-clock fs-5"></i>
          </div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <div class="text-muted small fw-semibold">Vacant & Open</div>
            <h3 class="fw-bold mb-0 text-primary"><%= stats.available %></h3>
          </div>
          <div class="rounded-circle bg-primary-subtle p-3 text-primary">
            <i class="fa-solid fa-door-open fs-5"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Listings Table Card -->
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="card-header bg-white border-0 py-3 px-4 d-flex align-items-center justify-content-between">
      <h5 class="fw-bold mb-0 text-dark">Your Accommodations</h5>
      <span class="text-muted small"><%= listings.length %> property<%= listings.length === 1 ? '' : 'ies' %></span>
    </div>

    <% if (listings && listings.length > 0) { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 px-4">
          <thead class="table-light text-muted small">
            <tr>
              <th scope="col" class="ps-4">Property</th>
              <th scope="col">Monthly Rent</th>
              <th scope="col">Review Status</th>
              <th scope="col">Student Availability</th>
              <th scope="col" class="text-end pe-4">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% for (let pg of listings) { %>
              <tr>
                <td class="ps-4 py-3">
                  <div class="d-flex align-items-center gap-3">
                    <img
                      src="<%= (pg.image && pg.image.url) || '/images/placeholder.jpg' %>"
                      alt="<%= pg.title %>"
                      class="rounded-3 shadow-sm"
                      style="width: 60px; height: 60px; object-fit: cover;"
                    />
                    <div>
                      <h6 class="fw-bold mb-0 text-dark"><%= pg.title %></h6>
                      <small class="text-muted"><i class="fa-solid fa-location-dot me-1"></i><%= pg.location %></small>
                    </div>
                  </div>
                </td>

                <td class="fw-semibold text-dark">
                  ₹<%= (pg.rentMin || pg.price || 0).toLocaleString("en-IN") %>
                </td>

                <td>
                  <% if (pg.status === 'approved') { %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                      <i class="fa-solid fa-check me-1"></i> Approved
                    </span>
                  <% } else if (pg.status === 'pending') { %>
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2 rounded-pill">
                      <i class="fa-solid fa-clock me-1"></i> Pending Review
                    </span>
                  <% } else if (pg.status === 'rejected') { %>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill">
                      <i class="fa-solid fa-xmark me-1"></i> Rejected
                    </span>
                  <% } else { %>
                    <span class="badge bg-secondary-subtle text-secondary border px-3 py-2 rounded-pill">
                      <%= pg.status %>
                    </span>
                  <% } %>
                </td>

                <td>
                  <form action="/owner/listings/<%= pg._id %>/toggle-availability" method="POST" class="d-inline">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <% if (pg.isAvailable) { %>
                      <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-3" title="Click to mark as Occupied">
                        <i class="fa-solid fa-toggle-on text-success me-1"></i> Available
                      </button>
                    <% } else { %>
                      <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill px-3" title="Click to mark as Available">
                        <i class="fa-solid fa-toggle-off text-muted me-1"></i> Occupied
                      </button>
                    <% } %>
                  </form>
                </td>

                <td class="text-end pe-4">
                  <div class="d-inline-flex gap-2">
                    <a href="/listings/<%= pg._id %>" class="btn btn-sm btn-light rounded-pill" title="View Listing">
                      <i class="fa-solid fa-eye"></i>
                    </a>
                    <a href="/listings/<%= pg._id %>/edit" class="btn btn-sm btn-light rounded-pill text-primary" title="Edit Listing">
                      <i class="fa-solid fa-pen"></i>
                    </a>
                    <form action="/listings/<%= pg._id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this listing?');">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-sm btn-light rounded-pill text-danger" title="Delete Listing">
                        <i class="fa-solid fa-trash"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <!-- Empty State -->
      <div class="text-center py-5">
        <div class="rounded-circle bg-danger-subtle text-danger d-inline-flex align-items-center justify-content-center p-4 mb-3">
          <i class="fa-solid fa-house-chimney-medical fs-2"></i>
        </div>
        <h4 class="fw-bold mb-1">No PG Listings Yet</h4>
        <p class="text-muted mb-4">Start by adding your first student accommodation listing.</p>
        <a href="/listings/new" class="btn btn-danger rounded-pill px-4 fw-semibold">
          <i class="fa-solid fa-plus me-1"></i> Add Your First Listing
        </a>
      </div>
    <% } %>
  </div>
</div>

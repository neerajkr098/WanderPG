<% layout("/layouts/boilerplate") %>

<div class="container my-5">
  <!-- Hero Section -->
  <div class="row justify-content-center text-center mb-5">
    <div class="col-lg-8">
      <div class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill mb-3 fw-semibold">
        <i class="fa-solid fa-graduation-cap me-1"></i> Student Housing Simplified
      </div>
      <h1 class="display-5 fw-bold mb-3 text-dark">Find Student PGs Near Your College</h1>
      <p class="lead text-muted mb-4">
        Discover verified PG accommodations within walking distance or a short commute from your campus.
      </p>

      <!-- Search Box -->
      <form action="/colleges" method="GET" class="card shadow-sm border-0 p-2 rounded-pill">
        <div class="input-group">
          <span class="input-group-text bg-transparent border-0 ps-3">
            <i class="fa-solid fa-magnifying-glass text-muted"></i>
          </span>
          <input
            type="text"
            name="q"
            value="<%= q %>"
            class="form-control border-0 shadow-none px-2 py-3"
            placeholder="Search by college name or city (e.g., Delhi University, IIT)..."
            maxlength="100"
          />
          <button class="btn btn-danger px-4 rounded-pill fw-semibold" type="submit">
            Search
          </button>
        </div>
      </form>
      <% if (q) { %>
        <div class="mt-3 text-start ps-3">
          <span class="text-muted">Showing results for "<strong><%= q %></strong>"</span>
          <a href="/colleges" class="ms-2 text-danger text-decoration-none small">Clear search</a>
        </div>
      <% } %>
    </div>
  </div>

  <!-- College Cards Grid -->
  <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5">
    <% if (colleges && colleges.length > 0) { %>
      <% for (let college of colleges) { %>
        <div class="col">
          <div class="card h-100 shadow-sm border-0 rounded-4 transition-hover">
            <div class="card-body p-4 d-flex flex-column">
              <div class="d-flex align-items-center mb-3">
                <div class="rounded-circle bg-danger-subtle text-danger p-3 me-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                  <i class="fa-solid fa-building-columns fs-5"></i>
                </div>
                <div>
                  <h5 class="card-title mb-1 fw-bold text-dark"><%= college.name %></h5>
                  <span class="text-muted small">
                    <i class="fa-solid fa-location-dot me-1 text-danger"></i><%= college.city %>, <%= college.state %>
                  </span>
                </div>
              </div>
              <p class="card-text text-muted small flex-grow-1">
                Explore student hostels and paying guest options within 5 km of campus.
              </p>
              <div class="mt-3 pt-3 border-top">
                <a href="/colleges/<%= college.slug %>" class="btn btn-outline-danger w-100 rounded-pill fw-semibold">
                  View Nearby PGs <i class="fa-solid fa-arrow-right ms-1"></i>
                </a>
              </div>
            </div>
          </div>
        </div>
      <% } %>
    <% } else { %>
      <div class="col-12 text-center py-5">
        <div class="mb-3 text-muted">
          <i class="fa-solid fa-circle-question fs-1"></i>
        </div>
        <h4 class="fw-bold">No colleges found matching "<%= q %>"</h4>
        <p class="text-muted">Try searching for a different college name or city, or browse all colleges.</p>
        <a href="/colleges" class="btn btn-danger rounded-pill px-4">Browse All Colleges</a>
      </div>
    <% } %>
  </div>

  <!-- Pagination -->
  <% if (totalPages > 1) { %>
    <nav class="d-flex justify-content-center my-4">
      <ul class="pagination pagination-rounded">
        <% if (page > 1) { %>
          <li class="page-item">
            <a class="page-link" href="/colleges?page=<%= page - 1 %><%= q ? '&q=' + encodeURIComponent(q) : '' %>">Previous</a>
          </li>
        <% } %>
        <% for (let i = 1; i <= totalPages; i++) { %>
          <li class="page-item <%= page === i ? 'active' : '' %>">
            <a class="page-link" href="/colleges?page=<%= i %><%= q ? '&q=' + encodeURIComponent(q) : '' %>"><%= i %></a>
          </li>
        <% } %>
        <% if (page < totalPages) { %>
          <li class="page-item">
            <a class="page-link" href="/colleges?page=<%= page + 1 %><%= q ? '&q=' + encodeURIComponent(q) : '' %>">Next</a>
          </li>
        <% } %>
      </ul>
    </nav>
  <% } %>
</div>

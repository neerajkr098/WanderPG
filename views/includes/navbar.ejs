<style>
  .search-btn{
    background-color: #fe424d;
    color: #fff;
    border-radius: 25px ;
    padding: 0 1rem 0rem 1rem;
  }
  .search-btn:hover{
    background-color: #fe424d;
    color: #fff;
  }
  .search-btn i {
    display: inline;
    margin-right: 0.5rem;
  }

  .search-inp{
    border-radius: 25px;
    padding: 0.5rem 3rem 0.5rem 3rem;
    font-size: 1rem;
  }

  .logout-form-inline {
    display: inline;
    margin: 0;
    padding: 0;
  }

  .logout-btn-link {
    background: none;
    border: none;
    padding: 0.5rem 1rem;
    color: rgba(0, 0, 0, 0.65);
    font-weight: bold;
    cursor: pointer;
  }

  .logout-btn-link:hover {
    color: rgba(0, 0, 0, 0.9);
  }
</style>
<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/colleges">
      <i class="fa-solid fa-graduation-cap text-danger fs-4"></i>
      <span class="fw-bold" style="color: #fe424d; font-size: 1.25rem;">WanderPG</span>
    </a>
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
    >
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        <a class="nav-link" href="/colleges">Colleges</a>
        <a class="nav-link" href="/listings">All PGs</a>
      </div>
      
      <div class="navbar-nav ms-auto">
        <form class="d-flex" role="search" action="/colleges" method="GET">
          <input class="form-control me-2 search-inp" type="search" name="q" placeholder="Search college or city..." />
          <button class="btn search-btn" type="submit"><i class="fa-solid fa-magnifying-glass"></i>Search</button>
        </form>
      </div>

       <div class="navbar-nav ms-auto align-items-center">
        <% if (currUser && currUser.role === 'admin') { %>
          <a class="nav-link" href="/admin/dashboard"><i class="fa-solid fa-shield-halved text-danger me-1"></i><b>Admin Queue</b></a>
          <a class="nav-link" href="/owner/listings"><i class="fa-solid fa-gauge me-1"></i>Owner Hub</a>
        <% } else if (currUser && currUser.role === 'owner') { %>
          <a class="nav-link" href="/owner/listings"><i class="fa-solid fa-gauge me-1"></i><b>Dashboard</b></a>
          <a class="nav-link" href="/owner/enquiries"><i class="fa-solid fa-inbox me-1"></i>Enquiries</a>
          <a class="nav-link" href="/listings/new">List PG</a>
        <% } else if (currUser) { %>
          <span class="navbar-text small text-muted me-2"><i class="fa-solid fa-user-graduate me-1"></i><%= currUser.username %></span>
        <% } else { %>
          <a class="nav-link" href="/listings/new">List your PG</a>
          <a class="nav-link" href="/signup"><b>Sign up</b></a>
          <a class="nav-link" href="/login"><b>Log in</b></a>
        <% } %>
       <% if (currUser) { %>
         <form action="/logout" method="POST" class="logout-form-inline">
           <input type="hidden" name="_csrf" value="<%= csrfToken %>">
           <button type="submit" class="logout-btn-link">Log out</button>
         </form>
       <% } %>
      </div>
    </div>
  </div>
</nav>
